# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (optional on Vercel; VERCEL_URL / Host header used automatically).
APP_URL="MY_APP_URL"

# PostgreSQL Database URL (Required on Vercel for persistent storage across serverless instances)
# Connect Neon, Supabase, or Vercel Postgres in Vercel Storage to populate DATABASE_URL / POSTGRES_URL automatically.
DATABASE_URL=""

# SMTP Email Configuration (optional — if omitted, emails are previewed in the built-in outbox)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Marché de Noël École Saint-Pierre <no-reply@ecole-saint-pierre.fr>"

# Organizer access code for Espace organisateur (default: STPIERRE2026)
ORGANIZER_PIN="STPIERRE2026"

# Vercel Cron secret (automatically sent by Vercel Cron in Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
